+"""MDB integration tests."""
+import pytest
+import tempfile
+import os
+from pathlib import Path
+from unittest.mock import patch, MagicMock
+
+@pytest.mark.integration
+def test_mdb_upload_flow():
+    """Test complete MDB upload flow."""
+    pytest.skip("Requires actual MDB test file")
+
+def test_format_detection_mdb():
+    """Test MDB format detection."""
+    from app.services.format_detection import detect_data_type
+    data_type = detect_data_type("test.mdb", b"Standard Jet DB")
+    assert data_type == "spatial"
+
+def test_mdb_processor_import():
+    """Test MDB processor can be imported."""
+    from app.services.mdb_processor import extract_mdb_features, extract_mdb_to_stored_files
+    assert callable(extract_mdb_features)
+    assert callable(extract_mdb_to_stored_files)
+
+def test_convert_shape_to_geojson_wkt():
+    """Test WKT to GeoJSON conversion."""
+    from app.services.mdb_processor import _convert_shape_to_geojson
+    result = _convert_shape_to_geojson("POINT (1.0 2.0)")
+    assert result is not None
+    assert result["type"] == "Point"
+    assert result["coordinates"] == [1.0, 2.0]
+
+def test_detect_geometry_type():
+    """Test geometry type detection."""
+    from app.services.mdb_processor import _detect_geometry_type
+    features = [
+        {"geometry": {"type": "Point"}},
+        {"geometry": {"type": "Point"}},
+        {"geometry": {"type": "LineString"}},
+    ]
+    assert _detect_geometry_type(features) == "Point"
+
+def test_extract_mdb_to_stored_files_happy_path():
+    """Test StoredFile conversion happy path."""
+    from app.services.mdb_processor import extract_mdb_to_stored_files
+    from unittest.mock import patch
+    
+    mock_tables = [
+        {
+            "table_name": "Buildings",
+            "geometry_type": "Polygon",
+            "features": [
+                {"type": "Feature", "geometry": {"type": "Polygon", "coordinates": [[[0, 0], [1, 0], [1, 1], [0, 1], [0, 0]]]}, "properties": {"name": "A"}},
+            ],
+            "fields": ["Shape", "name"],
+        }
+    ]
+    
+    with patch("app.services.mdb_processor.extract_mdb_features", return_value=mock_tables):
+        results = extract_mdb_to_stored_files(
+            content=b"\x00" * 10,
+            filename="test.mdb",
+            api_key_id="key-1",
+            max_bytes=10_000_000,
+        )
+        assert len(results) == 1
+        assert results[0]["features"] == mock_tables[0]["features"]
+
+def test_upload_endpoint_exists():
+    """Test upload endpoint exists."""
+    from fastapi.testclient import TestClient
+    from app.main import app
+    client = TestClient(app)
+    response = client.get("/api/v1/data/upload")
+    assert response.status_code != 404