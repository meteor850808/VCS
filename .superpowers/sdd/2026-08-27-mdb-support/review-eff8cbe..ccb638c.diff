+import pytest
+from app.services.format_detection import detect_data_type, TABLE_FORMATS, GEOMETRY_FORMATS
+
+def test_mdb_data_type_detection():
+    """Test that MDB is detected as spatial data type."""
+    # MDB 应该被检测为 spatial 而不是 table
+    data_type = detect_data_type("test.mdb", b"Standard Jet DB")
+    assert data_type == "spatial"  # 而不是 "table"
+
+def test_mdb_format_classification():
+    """Test that MDB is in SPATIAL_FORMATS, not TABLE_FORMATS."""
+    # MDB 不应该在 TABLE_FORMATS 中
+    assert "MDB" not in TABLE_FORMATS
+    # MDB 应该在 GEOMETRY_FORMATS 中（或新的 SPATIAL_FORMATS）
+    # 注意：可能需要创建新的 SPATIAL_FORMATS 分类
+
+def test_mdb_in_personal_gdb_formats():
+    """Test that MDB is in PERSONAL_GDB_FORMATS."""
+    from app.services.format_detection import PERSONAL_GDB_FORMATS
+    assert "MDB" in PERSONAL_GDB_FORMATS
+
+def test_mdb_extension_detection():
+    """Test MDB detection by extension."""
+    data_type = detect_data_type("data.mdb", b"")
+    assert data_type == "spatial"
+
+def test_mdb_content_detection():
+    """Test MDB detection by content header."""
+    data_type = detect_data_type("unknown.bin", b"Standard Jet DB")
+    assert data_type == "spatial"
+
+def test_mdb_case_insensitive():
+    """Test MDB detection is case insensitive."""
+    data_type = detect_data_type("DATA.MDB", b"")
+    assert data_type == "spatial"
+
+def test_csv_still_table():
+    """Test that CSV is still classified as table."""
+    data_type = detect_data_type("data.csv", b"")
+    assert data_type == "table"