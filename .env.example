# 环境变量模板
# 复制为 .env 后修改: cp .env.example .env

# ── 数据库 ──────────────────────────
# Docker Compose: postgresql+asyncpg://postgres:postgres@postgres:5432/vcs_db
# 本地开发:     postgresql+asyncpg://postgres:postgres@localhost:5432/vcs_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vcs_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/vcs_db
# 连接池：异步引擎（主请求+子任务）/ 同步引擎（GDB 读取串行化，自动取 min(3)）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=15
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=30
# 子任务并发上限（asyncio.Semaphore，防止连接池被单次上传撑满）
MAX_CONCURRENT_DB_TASKS=5

# ── Redis / Celery ──────────────────
# Docker Compose: redis://redis:6379/0
# 本地开发:     redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── 安全 ────────────────────────────
# SECRET_KEY 已弃用（v2.20）：全仓零引用，勿再配置，存量 .env 可保留（字段兼容）或删除
# 引导密钥（必填且必须为强随机值，缺失/弱口令将拒绝启动）
# 生成示例（PowerShell）：[Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Max 256}))
ADMIN_INIT_KEY=replace-with-a-strong-random-key
CORS_ORIGINS=["*"]

# ── 应用 ────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
QUALITY_REPORT_DIR=./data/quality_reports
# 容器内（docker-compose）上述目录会被覆盖为 /data/... 绝对路径；本地开发保持 ./data/...
# 预览目录不在配置中（由 UPLOAD_DIR 的父目录 + /previews 派生）
MAX_BATCH_SIZE=50
MAX_DATA_STORE_SIZE_MB=200
SANDBOX_LIMIT=1000
FRONTEND_DIR=app/frontend
WS_HEARTBEAT_INTERVAL=30
